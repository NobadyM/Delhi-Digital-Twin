# ========================================================
# Delhi Digital Twin - Environment Configuration
# ========================================================

# Application Settings
APP_NAME="Delhi Digital Twin API"
APP_VERSION="2.1.0"
ENVIRONMENT="production"
DEBUG=false

# Server Configuration
HOST="127.0.0.1"
PORT=8001

# Persistent Database Configuration
# Default: Local SQLite (Zero-configuration)
DATABASE_URL="sqlite:///delhi_digital_twin.db"

# Production PostgreSQL Example:
# DATABASE_URL="postgresql://delhi_twin_user:secure_password@localhost:5432/delhi_digital_twin"

# Upstream Ingestion & Freshness
OPEN_METEO_URL="https://air-quality-api.open-meteo.com/v1/air-quality"
REQUEST_TIMEOUT_SECONDS=25
INGESTION_INTERVAL_SECONDS=300
STALE_THRESHOLD_MINUTES=120
DELAYED_THRESHOLD_MINUTES=30

# Machine Learning & Forecasting
MODEL_VERSION="isolation_forest_v1.0"
FORECAST_MODEL_VERSION="trend_ar_v1.0"

# CORS Configuration (JSON array string)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:4173", "http://127.0.0.1:4173", "*"]'
